# ---------------------------------------------------------------------------
# Supervisor (src/app.ts)
# ---------------------------------------------------------------------------

# Discord application
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id
QUESTION_CHANNEL_ID=your_text_channel_id

# Comma-separated Discord user IDs allowed to run /create-container.
# At least one is required. Other users can still answer agent questions in
# QUESTION_CHANNEL_ID, so keep that channel private.
AUTHORIZED_USER_IDS=123456789012345678

# Shared secret for the supervisor <-> worker bridge. Must be at least 16
# characters and must match the value injected into worker containers.
BRIDGE_TOKEN=replace-with-a-long-random-string

# Used only by the supervisor LLM proxy. Worker containers never see this key;
# they call the proxy with BRIDGE_TOKEN instead.
OPENROUTER_API_KEY=your_openrouter_key

# Bridge listener. The default binds all interfaces because worker containers
# reach the host through host.docker.internal. Set WS_HOST to the Docker bridge
# gateway (for example 172.17.0.1) to reduce exposure, and firewall the port.
WS_HOST=0.0.0.0
WS_PORT=3000

# Image built from app_template3/
WORKER_IMAGE=bun-typescript-app

# Optional worker command allowlist (comma-separated). Leave empty to use the
# worker's built-in default list. Set to * to disable the allowlist entirely.
# This is a guardrail, not a security boundary; the container is the boundary.
ALLOWED_COMMANDS=

# Optional model overrides. Free OpenRouter model IDs rotate, so check
# https://openrouter.ai/models?max_price=0 if the defaults stop working.
# These are passed to the worker container only when set.
# LLM_MODEL=cohere/north-mini-code:free
# PLANNER_MODEL=google/gemma-4-31b-it:free
# CODER_MODEL=cohere/north-mini-code:free
# MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Worker (injected by the supervisor; shown for manual runs)
# ---------------------------------------------------------------------------
# WS_URL=ws://host.docker.internal:3000/ws
# LLM_ENDPOINT=http://host.docker.internal:3000/llm/chat/completions
# PROJECT_DIR=/app
